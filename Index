<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TEMPORARY™ — Order System</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=Montserrat:wght@300;400;500;600;700&display=swap');
    
    * { box-sizing: border-box; }
    body { margin: 0; background: #030303; color: #f3f3f3; font-family: 'Montserrat', sans-serif; min-height: 100vh; -webkit-font-smoothing: antialiased; }
    .container { max-width: 720px; margin: auto; padding: 32px 16px 80px; }
    
    .header { text-align: center; padding: 20px 0 36px; border-bottom: 1px solid #161616; margin-bottom: 32px; }
    .logo { font-family: 'Cinzel', serif; font-size: 42px; font-weight: 900; letter-spacing: 4px; color: #ffffff; text-shadow: 0 0 30px rgba(255,255,255,0.15); }
    .tagline { font-size: 10px; letter-spacing: 7px; color: #888; margin-top: 10px; text-transform: uppercase; font-weight: 600; }
    
    .eyebrow { text-align: center; font-size: 10px; letter-spacing: 6px; color: #e5e5e5; margin-bottom: 8px; font-weight: 700; text-transform: uppercase; }
    h1 { font-family: 'Cinzel', serif; font-size: 26px; letter-spacing: 2px; margin: 0 0 24px; text-transform: uppercase; text-align: center; color: #ffffff; font-weight: 800; }
    .intro { font-size: 13px; color: #888; line-height: 1.6; margin-bottom: 32px; font-weight: 300; text-align: center; }
    
    .section { margin-bottom: 40px; }
    .section-title { font-size: 11px; letter-spacing: 4px; font-weight: 700; margin-bottom: 16px; color: #dedede; text-transform: uppercase; border-left: 2px solid #fff; padding-left: 10px; }
    
    .card { background: #0a0a0a; border: 1px solid #1f1f1f; border-radius: 12px; padding: 20px; margin-bottom: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .item-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .item-number { font-size: 10px; letter-spacing: 3px; color: #888; font-weight: 700; }
    .remove { background: none; border: none; color: #777; font-size: 9px; letter-spacing: 2px; cursor: pointer; font-weight: 600; }
    .remove:hover { color: #ff4444; }
    
    /* Layered Preview Frame */
    .preview-container { width: 100%; aspect-ratio: 1 / 1; background: #060606; border: 1px solid #222; border-radius: 10px; margin-bottom: 20px; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .layer-mockup { position: absolute; width: 100%; height: 100%; object-fit: cover; z-index: 1; }
    .layer-chest { position: absolute; width: 15%; top: 32%; left: 34%; object-fit: contain; z-index: 2; pointer-events: none; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3)); }
    .layer-design { position: absolute; width: 45%; top: 28%; left: 27.5%; object-fit: contain; z-index: 3; pointer-events: none; filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4)); }
    .preview-placeholder { font-size: 10px; letter-spacing: 2px; color: #555; text-align: center; font-weight: 400; z-index: 4; }
    
    label { display: block; color: #999; font-size: 9px; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 8px; font-weight: 600; }
    input[type="text"], input[type="email"], input[type="tel"], select, textarea { width: 100%; background: #111; border: 1px solid #262626; color: #fff; border-radius: 8px; padding: 14px; font-family: 'Montserrat', sans-serif; font-size: 14px; margin-bottom: 18px; outline: none; transition: border-color 0.2s; }
    input:focus, select:focus, textarea:focus { border-color: #777; }
    
    .design-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 18px; }
    .choice { position: relative; }
    .choice input { position: absolute; opacity: 0; pointer-events: none; }
    .choice span { display: block; text-align: center; padding: 14px 8px; border: 1px solid #262626; border-radius: 8px; font-size: 10px; letter-spacing: 1px; cursor: pointer; background: #0c0c0c; font-weight: 600; transition: all 0.2s; }
    .choice input:checked + span { background: #fff; color: #000; border-color: #fff; font-weight: 800; }
    
    .size-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin-bottom: 8px; }
    .size-choice { position: relative; }
    .size-choice input { position: absolute; opacity: 0; pointer-events: none; }
    .size-choice span { display: block; text-align: center; padding: 12px 2px; border: 1px solid #262626; border-radius: 8px; font-size: 10px; cursor: pointer; background: #0c0c0c; font-weight: 600; }
    .size-choice input:checked + span { background: #fff; color: #000; border-color: #fff; font-weight: 800; }
    
    .measurement { color: #ff3333; font-size: 14px; font-weight: 700; margin-bottom: 18px; letter-spacing: 1px; }
    
    .color-grid { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 20px; }
    .color-choice { position: relative; width: 48px; text-align: center; }
    .color-choice input { position: absolute; opacity: 0; pointer-events: none; }
    .swatch { display: block; width: 38px; height: 38px; border-radius: 50%; border: 2px solid #333; margin: 0 auto; cursor: pointer; transition: all 0.2s; }
    .color-choice input:checked + .swatch { border-color: #fff; box-shadow: 0 0 0 2px #000, 0 0 0 3px #fff; }
    .color-name { display: block; font-size: 7px; color: #888; margin-top: 6px; letter-spacing: 0.5px; font-weight: 700; }
    
    .quantity { display: flex; width: 140px; border: 1px solid #262626; border-radius: 8px; overflow: hidden; background: #111; margin-top: 10px; }
    .quantity button { width: 44px; height: 42px; background: #161616; color: #fff; border: none; font-size: 18px; cursor: pointer; font-weight: 600; }
    .quantity-value { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; }
    
    .add { width: 100%; padding: 16px; background: transparent; color: #bbb; border: 1px dashed #444; border-radius: 8px; cursor: pointer; font-size: 10px; letter-spacing: 2px; font-family: 'Montserrat', sans-serif; font-weight: 700; transition: all 0.2s; }
    .add:hover { border-color: #fff; color: #fff; background: rgba(255,255,255,0.02); }
    
    .summary { background: #0a0a0a; border: 1px solid #1f1f1f; border-radius: 12px; padding: 20px; }
    .summary-row { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid #161616; }
    .summary-info { font-size: 11px; color: #999; line-height: 1.6; }
    .product-total { display: flex; flex-direction: column; font-size: 16px; font-weight: bold; padding-top: 16px; margin-top: 8px; border-top: 1px solid #262626; }
    
    .payment-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .payment { position: relative; }
    .payment input { position: absolute; opacity: 0; pointer-events: none; }
    .payment span { display: block; text-align: center; padding: 16px 6px; border: 1px solid #262626; border-radius: 8px; font-size: 10px; letter-spacing: 1px; cursor: pointer; background: #0c0c0c; font-weight: 600; }
    .payment input:checked + span { background: #fff; color: #000; border-color: #fff; font-weight: 800; }
    
    .confirm { display: flex; gap: 12px; color: #999; font-size: 11px; line-height: 1.5; cursor: pointer; margin-bottom: 24px; font-weight: 500; }
    .submit { width: 100%; padding: 18px; background: #fff; color: #000; border: none; border-radius: 8px; font-size: 11px; letter-spacing: 3px; font-weight: 900; cursor: pointer; font-family: 'Montserrat', sans-serif; transition: background 0.2s; }
    .submit:hover { background: #e0e0e0; }
    
    .loading { position: fixed; inset: 0; background: rgba(0,0,0,0.94); display: none; align-items: center; justify-content: center; z-index: 100; }
    .loading.active { display: flex; }
    .success { display: none; text-align: center; padding: 60px 10px; }
    .success.active { display: block; }
    .success-check { font-size: 42px; margin-bottom: 16px; color: #4bb543; }
    .success p { font-size: 13px; color: #bbb; line-height: 1.8; margin-top: 20px; font-weight: 300; }
  </style>
</head>
<body>
  <div class="container">
    <header class="header">
      <div class="logo">TEMPORARY™</div>
      <div class="tagline">A DIFFERENT TOMORROW</div>
    </header>

    <main id="main">
      <div class="eyebrow">NOT FOR EVERYONE</div>
      <h1>BUILD YOUR ORDER</h1>

      <section class="section">
        <div class="section-title">PIECES</div>
        <div id="items"></div>
        <button type="button" class="add" onclick="addItem()">+ ADD ANOTHER PIECE</button>
      </section>

      <section class="section">
        <div class="section-title">IDENTITY DETAILS</div>
        <input id="fullName" type="text" placeholder="Full Name" required>
        <input id="temporaryName" type="text" placeholder="TEMPORARY™ Name" required>
        <input id="email" type="email" placeholder="Email Address" required>
        <input id="phone" type="tel" placeholder="Phone Number" required>
      </section>

      <section class="section">
        <div class="section-title">DESTINATION</div>
        <select id="governorate" required>
          <option value="">Select Governorate</option>
          <option value="Alexandria">Alexandria</option>
          <option value="Cairo">Cairo</option>
        </select>
        <input id="area" type="text" placeholder="City / Area" required>
        <textarea id="address" placeholder="Full Delivery Address" required></textarea>
      </section>

      <section class="section">
        <div class="section-title">ORDER SUMMARY</div>
        <div id="summary" class="summary">Your order is empty.</div>
      </section>

      <section class="section">
        <div class="section-title">PAYMENT METHOD</div>
        <div class="payment-grid">
          <label class="payment"><input type="radio" name="payment" value="Cash on Delivery" checked><span>CASH<br>ON DELIVERY</span></label>
          <label class="payment"><input type="radio" name="payment" value="Online Payment"><span>ONLINE<br>PAYMENT</span></label>
        </div>
      </section>

      <section class="section">
        <label class="confirm"><input id="confirmation" type="checkbox"><span>I confirm that all details are accurate.</span></label>
        <button id="submitButton" class="submit" onclick="submitOrder()">PLACE ORDER</button>
      </section>
    </main>

    <section id="success" class="success">
      <div class="success-check">✓</div>
      <h1 style="font-size:22px; margin-top:20px;">ORDER REGISTERED</h1>
      <p id="successMessage"></p>
    </section>
  </div>

  <div id="loading" class="loading"><div style="font-size: 10px; letter-spacing: 4px; font-weight:700; color:#fff;">SECURING ORDER...</div></div>

  <script>
    var API_URL = "https://script.google.com/macros/s/AKfycbztFuMDrR1NSUeGO0ALVajN7YB_fhAaJvd0gbKz9ReO_uHkp68KsHb_t0NHFjMUU7UR/exec";

    var PRODUCTS = [
      { name: "Regular T-Shirt", price: 900, slug: "regular-tee", sizes: ["S", "M", "L", "XL", "XXL"], colors: ["Black", "White"] },
      { name: "Parasola Oversized", price: 900, slug: "parasola-tee", sizes: ["S", "M", "L", "XL", "XXL"], colors: ["Black", "White", "Navy", "Hunter Green", "Green", "Blue"] },
      { name: "Boulevard Oversized", price: 1100, slug: "boulevard-tee", sizes: ["S", "M", "L", "XL", "XXL"], colors: ["Black", "White", "Hunter Green", "Burgundy"] },
      { name: "Regular Long Sleeve", price: 900, slug: "long-sleeve", sizes: ["S", "M", "L", "XL", "XXL"], colors: ["Black", "White"] },
      { name: "Premium Oversized Crewneck", price: 1400, slug: "premium-crewneck", sizes: ["S", "M", "L", "XL", "XXL"], colors: ["Black", "White", "Hunter Green", "Blue", "Silver"] },
      { name: "Standard Oversized Hoodie", price: 1300, slug: "standard-hoodie", sizes: ["S", "M", "L", "XL", "XXL"], colors: ["Black", "White", "Silver", "Hunter Green"] },
      { name: "Premium Oversized Hoodie", price: 1500, slug: "premium-hoodie", sizes: ["S", "M", "L", "XL", "XXL"], colors: ["Black", "White", "Hunter Green", "Blue", "Silver", "Pink"] },
      { name: "Kids Regular T-Shirt", price: 600, slug: "kids-tee", sizes: ["4 YRS", "6 YRS", "8 YRS", "10 YRS", "12 YRS"], colors: ["Black", "White", "Navy", "Hunter Green", "Green", "Blue"] },
      { name: "Kids Regular Hoodie", price: 800, slug: "kids-hoodie", sizes: ["4 YRS", "6 YRS", "8 YRS", "10 YRS", "12 YRS"], colors: ["Black", "White", "Hunter Green", "Pink"] }
    ];

    var MEASUREMENTS = {
      "Regular T-Shirt": { "S": "52 × 69 cm", "M": "54 × 70 cm", "L": "56 × 73 cm", "XL": "58 × 74 cm", "XXL": "60 × 76 cm" },
      "Parasola Oversized": { "S": "56 × 70 cm", "M": "59 × 72 cm", "L": "62 × 73 cm", "XL": "65 × 75 cm", "XXL": "67 × 77 cm" },
      "Boulevard Oversized": { "S": "56 × 70 cm", "M": "59 × 72 cm", "L": "62 × 73 cm", "XL": "65 × 75 cm", "XXL": "67 × 77 cm" },
      "Regular Long Sleeve": { "S": "52 × 69 cm", "M": "54 × 70 cm", "L": "56 × 73 cm", "XL": "58 × 74 cm", "XXL": "60 × 76 cm" },
      "Premium Oversized Crewneck": { "S": "56 × 69 cm", "M": "58 × 70 cm", "L": "62 × 73 cm", "XL": "64 × 74 cm", "XXL": "66 × 76 cm" },
      "Standard Oversized Hoodie": { "S": "56 × 69 cm", "M": "58 × 70 cm", "L": "62 × 73 cm", "XL": "64 × 74 cm", "XXL": "66 × 76 cm" },
      "Premium Oversized Hoodie": { "S": "56 × 69 cm", "M": "58 × 70 cm", "L": "62 × 73 cm", "XL": "64 × 74 cm", "XXL": "66 × 76 cm" },
      "Kids Regular T-Shirt": { "4 YRS": "33 × 45 cm", "6 YRS": "35 × 47 cm", "8 YRS": "37 × 50 cm", "10 YRS": "39 × 53 cm", "12 YRS": "42 × 57 cm" },
      "Kids Regular Hoodie": { "4 YRS": "38 × 44 cm", "6 YRS": "39 × 46 cm", "8 YRS": "40 × 50 cm", "10 YRS": "42 × 53 cm", "12 YRS": "42 × 56 cm" }
    };

    var items = [];
    window.onload = function() { addItem(); };

    function addItem() {
      items.push({ id: Date.now(), product: "", design: "", size: "", color: "", quantity: 1, price: 0, slug: "" });
      renderItems();
    }

    function renderItems() {
      var container = document.getElementById("items");
      container.innerHTML = "";
      items.forEach(function(item, idx) { container.appendChild(createCard(item, idx)); });
    }

    function createCard(item, index) {
      var card = document.createElement("div");
      card.className = "card";

      var header = document.createElement("div");
      header.className = "item-top";
      header.innerHTML = '<span class="item-number">PIECE ' + String(index + 1).padStart(2, "0") + '</span>' +
        (items.length > 1 ? '<button type="button" class="remove" onclick="removeItem(' + item.id + ')">REMOVE</button>' : '');
      card.appendChild(header);

      var pSelect = document.createElement("select");
      pSelect.innerHTML = '<option value="">Select garment</option>';
      PRODUCTS.forEach(function(p) {
        var opt = document.createElement("option");
        opt.value = p.name;
        opt.textContent = p.name;
        if (p.name === item.product) opt.selected = true;
        pSelect.appendChild(opt);
      });
      pSelect.onchange = function() { 
        var prod = PRODUCTS.find(x => x.name === this.value);
        item.product = prod.name; item.slug = prod.slug; item.price = prod.price; 
        if(prod.colors.indexOf(item.color) === -1) item.color = ""; 
        if(prod.sizes.indexOf(item.size) === -1) item.size = ""; 
        if(!item.design) item.design = "Too SMART"; 
        renderItems(); updateSummary(); 
      };
      card.appendChild(pSelect);

      if (!item.product) return card;

      var prodObj = PRODUCTS.find(x => x.name === item.product);

      // Layered Preview Container (Mockup + Front Chest Logo + Back Design)
      var imgDiv = document.createElement("div");
      imgDiv.className = "preview-container";
      if (item.color) {
        var cStr = item.color.toLowerCase().replace(/ /g, "-");
        var mockupUrl = "https://raw.githubusercontent.com/temporaryeg26-afk/order/main/mockups/" + item.slug + "-" + cStr + ".png";
        var chestLogoUrl = "https://raw.githubusercontent.com/temporaryeg26-afk/order/main/designs/front%20logo.png";
        
        var designFileName = (item.design === "Too SMART") ? "Too SMART.png" : "Keep it real.png";
        var designUrl = "https://raw.githubusercontent.com/temporaryeg26-afk/order/main/designs/" + encodeURIComponent(designFileName);

        imgDiv.innerHTML = 
          '<img class="layer-mockup" src="' + mockupUrl + '" onerror="this.style.display=\'none\'">' +
          '<img class="layer-chest" src="' + chestLogoUrl + '">' +
          '<img class="layer-design" src="' + designUrl + '">';
      } else {
        imgDiv.innerHTML = '<div class="preview-placeholder">SELECT COLOR & DESIGN</div>';
      }
      card.appendChild(imgDiv);

      var dGrid = document.createElement("div"); dGrid.className = "design-grid";
      ["Too SMART", "Keep it real"].forEach(function(d) {
        dGrid.innerHTML += '<label class="choice"><input type="radio" name="d'+item.id+'" value="'+d+'" '+(item.design===d?'checked':'')+'><span>'+d.toUpperCase()+'</span></label>';
      });
      dGrid.onchange = function(e) { item.design = e.target.value; renderItems(); updateSummary(); };
      card.appendChild(dGrid);

      var cGrid = document.createElement("div"); cGrid.className = "color-grid";
      prodObj.colors.forEach(function(c) {
        var hex = {"Black":"#111","White":"#f5f5f5","Navy":"#173b73","Hunter Green":"#223f31","Green":"#30573e","Burgundy":"#5e1c21","Blue":"#2454a6","Silver":"#bcb","Pink":"#e89ab5"}[c];
        cGrid.innerHTML += '<label class="color-choice"><input type="radio" name="c'+item.id+'" value="'+c+'" '+(item.color===c?'checked':'')+'><span class="swatch" style="background:'+hex+'"></span><span class="color-name">'+c+'</span></label>';
      });
      cGrid.onchange = function(e) { item.color = e.target.value; renderItems(); updateSummary(); };
      card.appendChild(cGrid);

      var sGrid = document.createElement("div"); sGrid.className = "size-grid";
      prodObj.sizes.forEach(function(s) {
        sGrid.innerHTML += '<label class="size-choice"><input type="radio" name="s'+item.id+'" value="'+s+'" '+(item.size===s?'checked':'')+'><span>'+s+'</span></label>';
      });
      sGrid.onchange = function(e) { item.size = e.target.value; renderItems(); updateSummary(); };
      card.appendChild(sGrid);

      if (item.size && MEASUREMENTS[item.product] && MEASUREMENTS[item.product][item.size]) {
        var spec = document.createElement("div"); spec.className = "measurement";
        spec.textContent = "Dimensions: " + MEASUREMENTS[item.product][item.size];
        card.appendChild(spec);
      }

      var qWrap = document.createElement("div");
      qWrap.className = "quantity";
      qWrap.innerHTML = '<button type="button" onclick="changeQty('+item.id+', -1)">−</button><div class="quantity-value">' + item.quantity + '</div><button type="button" onclick="changeQty('+item.id+', 1)">+</button>';
      card.appendChild(qWrap);

      return card;
    }

    function removeItem(id) {
      items = items.filter(function(it) { return it.id !== id; });
      if (items.length === 0) addItem();
      else { renderItems(); updateSummary(); }
    }

    function changeQty(id, change) {
      var it = items.find(x => x.id === id);
      if (it.quantity + change >= 1 && it.quantity + change <= 10) it.quantity += change;
      renderItems(); updateSummary();
    }

    function updateSummary() {
      var summary = document.getElementById("summary");
      summary.innerHTML = "";
      var subtotal = 0;
      items.forEach(function(item) {
        if (!item.product) return;
        subtotal += item.price * item.quantity;
        summary.innerHTML += '<div class="summary-row"><div class="summary-info"><strong>'+item.product+'</strong><br>'+(item.design||"-")+' / '+(item.size||"-")+' / '+(item.color||"-")+' × '+item.quantity+'</div><div>'+(item.price * item.quantity)+' EGP</div></div>';
      });
      if(subtotal > 0) {
        summary.innerHTML += '<div class="product-total"><div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:12px; color:#888; font-weight:normal;"><span>Delivery (Cairo / Alexandria)</span><span>90 EGP</span></div><div style="display:flex; justify-content:space-between; border-top:1px solid #262626; padding-top:12px;"><span>TOTAL DUE</span><span>'+(subtotal+90)+' EGP</span></div></div>';
      } else {
        summary.innerHTML = "Your order is empty.";
      }
    }

    function submitOrder() {
      if(!document.getElementById("confirmation").checked) return alert("Please confirm your details are accurate before placing the order.");
      
      var payRadio = document.querySelector('input[name="payment"]:checked');
      if (!payRadio) return alert("Please select a payment method.");
      var payMethod = payRadio.value;
      
      var payload = {
        customer: { fullName: document.getElementById("fullName").value, temporaryName: document.getElementById("temporaryName").value, email: document.getElementById("email").value, phone: document.getElementById("phone").value },
        delivery: { governorate: document.getElementById("governorate").value, area: document.getElementById("area").value, address: document.getElementById("address").value },
        paymentMethod: payMethod,
        items: items.filter(i => i.product && i.size && i.color && i.design)
      };
      
      if(payload.items.length === 0) return alert("Please configure at least one piece completely (design, color, size).");

      document.getElementById("loading").classList.add("active");

      fetch(API_URL, { method: "POST", mode: "no-cors", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) })
      .then(function() {
        document.getElementById("loading").classList.remove("active");
        document.getElementById("main").style.display = "none";
        document.getElementById("success").classList.add("active");
        
        if(payMethod === "Cash on Delivery") {
          document.getElementById("successMessage").innerHTML = "Someone from TEMPORARY™ will contact you to confirm inventory allocation and shipping logistics.<br><br>Order should be received within 5-6 days.";
        } else {
          document.getElementById("successMessage").innerHTML = "Someone from TEMPORARY™ will contact you shortly with your online payment link and to confirm inventory allocation and shipping logistics.";
        }
        window.scrollTo(0, 0);
      });
    }
  </script>
</body>
</html>
